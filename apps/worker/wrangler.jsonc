{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Local development and tests use this top-level configuration. Nothing here needs an account.
  // Staging and production repeat the bindings because wrangler does not inherit them.
  "name": "virtual-temple",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "TempleRoom", "class_name": "TempleRoom" },
      { "name": "HallDirectory", "class_name": "HallDirectory" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TempleRoom", "HallDirectory"] }],
  "vars": {
    "TEMPLE_SLUG": "flagship",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
  },
  "env": {
    // A copy of production on its own address, for the load test and the acceptance checks.
    // Replace CHANGE-ME values before deploying (`pnpm deploy:staging` refuses until you do).
    "staging": {
      "name": "virtual-temple-staging",
      "workers_dev": true,
      "durable_objects": {
        "bindings": [
          { "name": "TempleRoom", "class_name": "TempleRoom" },
          { "name": "HallDirectory", "class_name": "HallDirectory" },
        ],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TempleRoom", "HallDirectory"] }],
      "vars": {
        "TEMPLE_SLUG": "flagship",
        "ALLOWED_ORIGINS": "https://virtual-temple-staging.andylai.workers.dev",
      },
      // The Worker also serves the built web app, so the page, the sockets and the API share one
      // address: no cross-origin requests, and the Content-Security-Policy can say 'self'.
      "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/ws", "/api/*", "/health"],
      },
      "observability": { "enabled": true },
      "ratelimits": [
        {
          "name": "CONNECT_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "HALLS_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "REPORT_LIMITER",
          "namespace_id": "2003",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
    },
    "production": {
      "name": "virtual-temple",
      "workers_dev": false,
      "routes": [{ "pattern": "andylai", "custom_domain": true }],
      "durable_objects": {
        "bindings": [
          { "name": "TempleRoom", "class_name": "TempleRoom" },
          { "name": "HallDirectory", "class_name": "HallDirectory" },
        ],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TempleRoom", "HallDirectory"] }],
      "vars": {
        "TEMPLE_SLUG": "flagship",
        "ALLOWED_ORIGINS": "https://virtual-temple-staging.andylai.workers.dev",
      },
      "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/ws", "/api/*", "/health"],
      },
      "observability": { "enabled": true },
      "ratelimits": [
        {
          "name": "CONNECT_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "HALLS_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "REPORT_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
    },
  },
}
