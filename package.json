{
  "name": "virtual-temple",
  "private": true,
  "version": "0.0.0",
  "description": "Virtual temple for Malaysian Buddhists. See docs/mvp/spec.md.",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n worker,web -c blue,green \"pnpm --filter @temple/worker dev\" \"pnpm --filter @temple/web dev\"",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "deploy:check": "pnpm --filter @temple/deploy start",
    "deploy:staging": "pnpm build && pnpm deploy:check staging && pnpm --filter @temple/worker exec wrangler deploy --env staging",
    "deploy:production": "pnpm build && pnpm deploy:check production && pnpm --filter @temple/worker exec wrangler deploy --env production",
    "loadtest": "pnpm --filter @temple/load-test start"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
